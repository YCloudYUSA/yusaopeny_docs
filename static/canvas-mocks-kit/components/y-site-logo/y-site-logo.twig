            <stop stop-color="var(--wsLogoTriangleLight, #00aeef)" offset="0%"/>
            <stop stop-color="var(--wsLogoTriangleDark, #0060af)" offset="100%"/>
          </radialGradient>
          <radialGradient cx="-15.35%" cy="18.71%" fx="-15.35%" fy="18.71%" r="193.28%" gradientTransform="translate(-0.1535,0.1871),scale(1,0.5974),translate(0.1535,-0.1871)" id="y-logo-chevron">
            <stop stop-color="var(--wsLogoChevronLight, #20bdbe)" offset="0%"/>
            <stop stop-color="var(--wsLogoChevronMid, #01a490)" offset="44%"/>
            <stop stop-color="var(--wsLogoChevronDark, #006b6b)" offset="100%"/>
          </radialGradient>
