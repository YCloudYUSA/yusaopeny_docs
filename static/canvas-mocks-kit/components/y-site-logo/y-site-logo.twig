{#
/**
 * Y Site Logo molecule.
 *
 * Variables:
 * - image: (object) Logo image with src, alt, width, height
 * - alt: (string) Alt text for image
 * - url: (string) Link URL (default: "/")
 * - site_name: (string) Text fallback
 */
#}

{% set url = url|default('/') %}
{% set alt = alt|default('Home') %}

<div class="y-site-logo" data-component="y-site-logo">
  <a href="{{ url }}" class="y-site-logo__link" rel="home" title="{{ alt }}">
    {% if image.src %}
      <img
        src="{{ image.src }}"
        alt="{{ alt }}"
        class="y-site-logo__image"
        loading="eager"
        {% if image.width %}width="{{ image.width }}"{% endif %}
        {% if image.height %}height="{{ image.height }}"{% endif %}
      />
    {% else %}
