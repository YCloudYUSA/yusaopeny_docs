{#
/**
 * Y Small Statistics component.
 *
 * Variables:
 * - title: (string) Section heading
 * - background: (string) Background style
 * - items: (slot) Statistics items
 */
#}

{% set bg = background|default('light') %}
{% set columns = columns|default(4) %}
{% set classes = [
  'small-y-statistics',
  'small-y-statistics--bg-' ~ bg,
  'small-y-statistics--cols-' ~ columns,
  style|default('standard') != 'standard' ? 'small-y-statistics--style-' ~ style,
  section|default('body') != 'body' ? 'small-y-statistics--section-' ~ section,
] %}

<section class="{{ classes|join(' ') }}" data-component="small-y-statistics">
  <div class="small-y-statistics__header">
    <div class="small-y-statistics__header-wrapper">
      {% if title %}
        <h2 class="small-y-statistics__title">{{ title }}</h2>
      {% endif %}
      {% if subtitle %}
        <p class="small-y-statistics__subtitle">{{ subtitle }}</p>
      {% endif %}
    </div>
    <div class="small-y-statistics__chevron">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 322 520" fill="none">
        <path d="m131.325 241.357.025.048v-.048h-.025Zm181.701 3.28-1.144-1.864L183.89 32.532l-2.239-3.657C170.805 11.017 149.983 0 126.872 0H21.32C9.553 0 0 9.059 0 20.217c0 3.468.846 6.795 2.537 9.578l128.838 211.61c5.896 9.507 9.254 20.571 9.254 32.39 0 11.819-3.184 22.222-8.757 31.541L19.877 489.344c-1.692 2.76-2.538 6.086-2.538 9.578 0 11.158 9.553 20.217 21.32 20.217h108.289c23.111 0 43.933-11.017 54.779-28.852l2.239-3.68 107.717-176.931 1.99-3.279c5.498-9.035 8.035-19.344 8.035-30.314 0-10.97-3.085-22.246-8.707-31.446h.025Z"/>
      </svg>
    </div>
    <div class="small-y-statistics__chevron small-y-statistics__chevron--lighter">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 322 520" fill="none">
        <path d="m131.325 241.357.025.048v-.048h-.025Zm181.701 3.28-1.144-1.864L183.89 32.532l-2.239-3.657C170.805 11.017 149.983 0 126.872 0H21.32C9.553 0 0 9.059 0 20.217c0 3.468.846 6.795 2.537 9.578l128.838 211.61c5.896 9.507 9.254 20.571 9.254 32.39 0 11.819-3.184 22.222-8.757 31.541L19.877 489.344c-1.692 2.76-2.538 6.086-2.538 9.578 0 11.158 9.553 20.217 21.32 20.217h108.289c23.111 0 43.933-11.017 54.779-28.852l2.239-3.68 107.717-176.931 1.99-3.279c5.498-9.035 8.035-19.344 8.035-30.314 0-10.97-3.085-22.246-8.707-31.446h.025Z"/>
      </svg>
    </div>
  </div>
  <div class="small-y-statistics__container">
    <div class="small-y-statistics__grid">
      {{ items }}
    </div>
  </div>
</section>
