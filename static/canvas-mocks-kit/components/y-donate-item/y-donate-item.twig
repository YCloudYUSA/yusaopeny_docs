{#
/**
 * Y Donate Item component.
 *
 * Variables:
 * - amount: (string) Donation amount
 * - description: (string) Impact description
 * - url: (string) Donation URL
 * - highlighted: (boolean) Featured option
 */
#}

{% set classes = [
  'y-donate-item',
  highlighted ? 'y-donate-item--highlighted' : '',
  section|default('body') != 'body' ? 'y-donate-item--section-' ~ section,
] %}

<a href="{{ url|default('#') }}" class="{{ classes|join(' ') }}" data-component="y-donate-item">
  <span class="y-donate-item__amount">{{ amount }}</span>
  {% if description %}
    <span class="y-donate-item__description">{{ description }}</span>
  {% endif %}
</a>
