{#
/**
 * @file
 * Y Hero Banner component.
 * Styled after ws_small_y hero variations.
 *
 * Variables:
 * - title: (string) Hero heading text
 * - heading_level: (string) h1, h2, or h3
 * - description: (string) Supporting text (HTML)
 * - image: (object) Background image with src, alt, width, height
 * - variation: (string) tall, sub_chevron, sub_frame, promo, sub_chevron_no_media
 * - background: (string) color or gray
 * - cta_text: (string) Button label
 * - cta_url: (string) Button URL
 *
 * Canvas-injected variables:
 * - canvas_uuid: Unique component instance ID
 * - canvas_is_preview: Boolean for preview mode
 */
#}

{% set heading_level = heading_level|default('h2') %}
{% set variation = variation|default('tall') %}
{% set background = background|default('color') %}

{% set classes = [
  'hero__banner',
  'hero__banner__' ~ variation,
  'background-' ~ background,
  section|default('body') != 'body' ? 'y-hero--section-' ~ section,
] %}

<div {{ attributes.addClass(classes) }} data-component="y-hero">
  {# Banner wrapper with gradient background #}
  <div class="banner-wrapper">
    {# Chevron decoration - Y-shaped SVG from ws_small_y #}
    {% set chevron_svg %}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 322 520" fill="none">
        <path d="m131.325 241.357.025.048v-.048h-.025Zm181.701 3.28-1.144-1.864L183.89 32.532l-2.239-3.657C170.805 11.017 149.983 0 126.872 0H21.32C9.553 0 0 9.059 0 20.217c0 3.468.846 6.795 2.537 9.578l128.838 211.61c5.896 9.507 9.254 20.571 9.254 32.39 0 11.819-3.184 22.222-8.757 31.541L19.877 489.344c-1.692 2.76-2.538 6.086-2.538 9.578 0 11.158 9.553 20.217 21.32 20.217h108.289c23.111 0 43.933-11.017 54.779-28.852l2.239-3.68 107.717-176.931 1.99-3.279c5.498-9.035 8.035-19.344 8.035-30.314 0-10.97-3.085-22.246-8.707-31.446h.025Z"/>
      </svg>
    {% endset %}

    {% if variation != 'promo' %}
      <div class="chevron">
        {{ chevron_svg }}
      </div>
    {% endif %}

    {# Promo has desktop chevron on left #}
    {% if variation == 'promo' %}
      <div class="chevron chevron-desktop">
        {{ chevron_svg }}
      </div>
      <div class="chevron">
        {{ chevron_svg }}
      </div>
    {% endif %}

    {# Content wrapper #}
    <div class="wrapper-content">
      <div class="hero_banner-content">
        {# Heading #}
        {% if title %}
          <{{ heading_level }} class="block-title">
            {{ title }}
          </{{ heading_level }}>
        {% endif %}

        {# Description #}
        {% if description %}
          <div class="hero_banner-body">
            {{ description|raw }}
          </div>
        {% endif %}

        {# Call to Action #}
        {% if cta_text and cta_url %}
          <div class="cta-wrapper">
            <a href="{{ cta_url }}" class="btn btn-primary">
              {{ cta_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Image (not for no_media or promo variations) #}
  {% if image.src and variation != 'sub_chevron_no_media' and variation != 'promo' %}
    <div class="hero_banner-image">
      <img
        src="{{ image.src }}"
        alt="{{ image.alt|default('') }}"
        class="hero_banner--img"
        loading="lazy"
        {% if image.width %}width="{{ image.width }}"{% endif %}
        {% if image.height %}height="{{ image.height }}"{% endif %}
      />
    </div>
  {% endif %}
</div>
